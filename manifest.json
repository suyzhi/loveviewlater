{
  "manifest_version": 3,
  "name": "稍后再看",
  "version": "1.2.0",
  "minimum_chrome_version": "114",
  "description": "在右侧侧边栏管理稍后再看网页列表，支持右键菜单快速添加",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "稍后再看",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "打开/关闭稍后再看侧边栏"
    },
    "add-current-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "把当前页面添加到稍后再看"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-context.js"],
      "run_at": "document_start"
    }
  ]
}
